// SPDX-License-Identifier: GPL-3.0-or-later
// Independent NandStudio bus-routing demonstration, 2026.
CHIP BusSelect4 {
    IN first[4], second[4], chooseSecond;
    OUT selected[4];
    PARTS:
    Mux(a=first[0], b=second[0], sel=chooseSecond, out=selected[0]);
    Mux(a=first[1], b=second[1], sel=chooseSecond, out=selected[1]);
    Mux(a=first[2], b=second[2], sel=chooseSecond, out=selected[2]);
    Mux(a=first[3], b=second[3], sel=chooseSecond, out=selected[3]);
}
