// User-provided Xor implementation, retained as a regression fixture.
// Not a replacement for any bundled student project.
CHIP Xor {
    IN a, b;
    OUT out;
    PARTS:
    Not(in=a, out=Nota);
    Not(in=b, out=Notb);
    And(a=a, b=Notb, out=aAndNotb);
    And(a=Nota, b=b, out=NotaAndb);
    Or(a=aAndNotb, b=NotaAndb, out=out);
}
